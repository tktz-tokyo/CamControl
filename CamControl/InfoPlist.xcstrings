    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CamControl zeigt eine Live-Vorschau der ausgewählten Kamera an, so dass Sie Ihre Anpassungen in Echtzeit sehen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "CamControl shows a live preview of the selected camera so you can see your adjustments in real time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CamControlは、カメラの設定変更をリアルタイムで確認できるよう、選択したカメラのライブプレビューを表示します。"
          }
        }
      }
