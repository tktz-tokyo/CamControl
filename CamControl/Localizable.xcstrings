    "Show Main Window": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauptfenster anzeigen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインウインドウを表示"
          }
        }
      }
    },
    "This camera doesn’t expose any settings that CamControl can adjust.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kamera bietet keine Einstellungen, die CamControl steuern kann."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカメラにはCamControlで調整できる設定がありません。"
          }
        }
      }
    },
    "This camera’s settings can’t be adjusted by CamControl. Only cameras connected via USB can be controlled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen dieser Kamera können von CamControl nicht verändert werden. Nur über USB angeschloßene Kameras sind steuerbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカメラの設定はCamControlでは調整できません。USB接続のカメラのみ操作できます。"
          }
        }
      }
    },
    "This resets all settings to the camera’s built-in defaults. This can’t be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies setzt die Kamera auf ihre Grundeinstellungen zurück. Es kann nicht rückgängig gemacht werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定をカメラ本体の初期値に戻します。この操作は取り消せません。"
          }
        }
      }
    },
    "Tilt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neigen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チルト（上下）"
          }
        }
      }
    },
    "To automatically re-apply saved settings to connected cameras, this application must be running. Launch it when you log in so that it runs in the background.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit gespeicherte Einstellungen automatisch auf verbundene Kameras angewendet werden, muss diese App laufen. Beim Anmelden starten, damit sie im Hintergrund läuft."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続したカメラに保存済みの設定を自動で再適用するには、CamControlを起動しておく必要があります。ログイン時に起動すると、バックグラウンドで動作します。"
          }
        }
      }
    },
